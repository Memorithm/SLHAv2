+                },
+                SLHA_OK
+            );
+            assert_eq!(score, first, "repeated execution must be bit-identical");
+        }
+
+        assert_eq!(unsafe { slha_weights_release(handle) }, SLHA_OK);
+        let _ = std::fs::remove_file(&path);
+    }
