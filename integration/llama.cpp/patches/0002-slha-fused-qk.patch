@@ -2396,6 +2400,33 @@ ggml_tensor * llm_graph_context::build_attn_mha(
     ggml_tensor * cur;
 
     const bool use_flash_attn = cparams.flash_attn && kq_b == nullptr;
+#if defined(SLHA_INTEGRATION)
+    // SLHA compressed-score integration, two modes selected via SLHA_KV_MODE:
+    //
+    //  * scorediag — side branch only: compute SLHA scores from the encoded
+    //    tiles, compare them with the true QK^T scores (cos, KL), and leave
+    //    the attention output untouched. Diagnostics only.
+    //
+    //  * fused — REPLACE the QK^T scores with the SLHA scores (see the
+    //    replacement in the standard attention path below): the attention
+    //    output becomes softmax(SLHA_kq) · V. Flash attention is disabled in
+    //    this mode because the fused node is a custom GGML op on the standard
+    //    attention path.
+    //
+    // The diagnostic node is built before the standard / flash-attention paths
+    // so it executes in all attention configurations.
+    {
+        const bool slha_diag =
+            slha_get_layer_state(il) &&
+            slha_get_layer_state(il)->mode == SLHA_KV_SCORE_DIAG;
+        if (slha_diag) {
+            ggml_tensor * kq_diag = ggml_mul_mat(ctx0, k, q);
+            kq_diag = slha_build_fused_qk(ctx0, kq_diag, k, q, il, gf);
+            (void)kq_diag;
+        }
+    }
+#endif
+
     if (use_flash_attn) {
         GGML_ASSERT(kq_b == nullptr && "Flash attention does not support KQ bias yet");
 
@@ -2472,6 +2503,19 @@ ggml_tensor * llm_graph_context::build_attn_mha(
             cb(kq, "kq_plus_kq_b", il);
