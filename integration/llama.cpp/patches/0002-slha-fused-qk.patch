+#if defined(SLHA_INTEGRATION)
+        // FUSED mode: replace the QK^T scores with SLHA scores computed on the
+        // compressed tiles. The custom node writes the SLHA scores into kq
+        // (slots without a tile fall back to the true score, so attention is
+        // never broken during warmup). The softmax below then operates on the
+        // SLHA scores. This is the standard (non-flash) attention path.
+        if (slha_get_layer_state(il) &&
+            slha_get_layer_state(il)->mode == SLHA_KV_FUSED) {
+            kq = slha_build_fused_qk(ctx0, kq, k, q, il, gf);
+            cb(kq, "kq_slha_fused", il);
+        }
+#endif
+
         kq = ggml_soft_max_ext(ctx0, kq, kq_mask, kq_scale, hparams.f_max_alibi_bias);
         ggml_soft_max_add_sinks(kq, sinks);
